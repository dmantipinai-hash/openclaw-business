# Enterprise Air-Gap Deployment — Environment Variables
# Скопируй в .env и заполните плейсхолдеры

# ═══ OpenClaw Gateway ═══

# Токен для локального доступа (fallback, если без прокси)
OPENCLAW_GATEWAY_TOKEN=change-me-to-random-string

# Часовой пояс
OPENCLAW_TZ=Europe/Moscow

# Порт (если публикуешь наружу, но в air-gap — НЕ публикуй)
OPENCLAW_GATEWAY_PORT=18789

# Docker image (собранный из Dockerfile)
OPENCLAW_IMAGE=openclaw:local

# ═══ Ollama LLM ═══

# Лимит памяти для Ollama (зависит от хоста)
OLLAMA_MEMORY_LIMIT=8G

# ═══ CA сертификаты (ФИЧА 7) ═══

# Путь к файлу CA сертификатов организации
# Для Windows: CA_CERT_PATH=./certs/ca-certificates.pem
# Для Linux:   CA_CERT_PATH=/etc/ssl/certs/company-ca.pem
CA_CERT_PATH=./certs/ca-certificates.pem

# ═══ Trusted Proxy (ФИЧА 2) ═══

# IP-адрес reverse proxy внутри контура
# PROXY_IP=10.0.0.1

# ═══ Reverse Proxy (для теста) ═══

# Если используешь nginx на хосте:
# PROXY_LISTEN_PORT=443
# PROXY_UPSTREAM=http://127.0.0.1:18789
# PROXY_SERVER_NAME=openclaw.company.local
