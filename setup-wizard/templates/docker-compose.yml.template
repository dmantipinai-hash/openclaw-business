# Enterprise Air-Gap Deployment — Docker Compose
# Сгенерировано setup-wizard: {{TIMESTAMP}}
#
# Использование:
#   1. Проверить .env
#   2. docker compose up -d
#   3. Проверить: docker compose ps

services:
  # ─── LLM ──────────────────────────────────────────────────────────
{{OLLAMA_SERVICE}}
  # ─── OpenClaw Gateway ──────────────────────────────────────────────
  openclaw-gateway:
    image: ${OPENCLAW_IMAGE:-openclaw:local}
    build:
      context: ..
      dockerfile: Dockerfile
    container_name: openclaw-enterprise
    restart: unless-stopped
    depends_on:
{{GATEWAY_DEPENDS_ON}}
    networks:
      - enterprise-internal
    extra_hosts:
      - "host.docker.internal:host-gateway"

    environment:
      HOME: /home/node
      OPENCLAW_HOME: /home/node
      OPENCLAW_STATE_DIR: /home/node/.openclaw
      OPENCLAW_CONFIG_PATH: /home/node/.openclaw/openclaw.json
      OPENCLAW_WORKSPACE_DIR: /home/node/.openclaw/workspace
      OPENCLAW_GATEWAY_TOKEN: ${OPENCLAW_GATEWAY_TOKEN:-}
      TZ: ${TZ:-{{TIMEZONE}}}
      NODE_EXTRA_CA_CERTS: /etc/openclaw/ca-certificates.pem

    volumes:
      - ../output/gateway.json5:/home/node/.openclaw/openclaw.json:ro
      - ../output/tool-policy.yaml:/home/node/.openclaw/tool-policy.yaml:ro
      - openclaw-workspace:/home/node/.openclaw/workspace
      - ${CA_CERT_PATH:-../certs/ca-certificates.pem}:/etc/openclaw/ca-certificates.pem:ro
      - openclaw-logs:/var/log/openclaw

    cap_drop:
      - NET_RAW
      - NET_ADMIN
    security_opt:
      - no-new-privileges:true
    read_only: true
    tmpfs:
      - /tmp:noexec

    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:18789/healthz').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 30s

    command:
      [
        "node", "dist/index.js", "gateway",
        "--bind", "lan",
        "--port", "{{GATEWAY_PORT}}",
      ]

  # ─── Kill Switch Watchdog ──────────────────────────────────────────
{{KILLSWITCH_SERVICE}}

networks:
  enterprise-internal:
    driver: bridge
    internal: true
    ipam:
      config:
        - subnet: 172.29.0.0/16

volumes:
  openclaw-workspace:
  openclaw-logs:
  {{OLLAMA_VOLUME}}
