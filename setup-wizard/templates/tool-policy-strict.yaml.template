# Enterprise Strict — комплаенс-зоны, конфиденциальные данные
# Сгенерировано setup-wizard: {{TIMESTAMP}}
# Deny-all, разрешено только чтение и поиск по памяти
# Для: юридический, финансовый, HR отделы

tools:
  profile: "deny-all"
  allow:
    - read
    - memory_search
    - memory_get
  deny:
    - web_search
    - web_fetch
    - exec
    - edit
    - write
    - browser
    - image_generate
    - sessions_spawn
  fs:
    workspaceOnly: true
  exec:
    disabled: true
