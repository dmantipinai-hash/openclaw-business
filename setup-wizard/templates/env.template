# ─── OpenClaw Enterprise — Environment Variables ────────────────────
# Сгенерировано setup-wizard: {{TIMESTAMP}}

# ─── LLM ────────────────────────────────────────────────────────────
LLM_PROVIDER={{LLM_PROVIDER}}
LLM_BASE_URL={{LLM_BASE_URL}}
LLM_MODEL={{LLM_MODEL_ID}}

# ─── Ollama (если выбран) ───────────────────────────────────────────
OLLAMA_MEMORY_LIMIT=8G

# ─── Gateway ─────────────────────────────────────────────────────────
OPENCLAW_IMAGE=openclaw:local
OPENCLAW_GATEWAY_TOKEN=
GATEWAY_PORT={{GATEWAY_PORT}}
TZ={{TIMEZONE}}

# ─── Auth ────────────────────────────────────────────────────────────
AUTH_METHOD={{AUTH_METHOD}}

# ─── Kill Switch ─────────────────────────────────────────────────────
KILLSWITCH_ENABLED={{KILLSWITCH_ENABLED}}
DASHBOARD_PORT={{DASHBOARD_PORT}}
WATCHDOG_GATEWAYS=http://openclaw-gateway:18789

# ─── Compliance ─────────────────────────────────────────────────────
COMPLIANCE_ENABLED={{COMPLIANCE_ENABLED}}
COMPLIANCE_URL={{COMPLIANCE_URL}}

# ─── CA Certificates ────────────────────────────────────────────────
CA_CERT_PATH=../certs/ca-certificates.pem
